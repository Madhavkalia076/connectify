<!DOCTYPE html>
<html lang="en">

<head>
  <%- include('partials/head', { title: (profileDisplayName || profileUsername) + ' — Connectify' }) %>
</head>

<body class="h-dvh overflow-hidden bg-slate-100 dark:bg-slate-900 font-sans text-gray-900 dark:text-gray-100 flex">

  <%- include('partials/sidebar', { rooms, conversations, unreadCounts, dmPartnerProfiles, myDisplayName, myProfilePicture, username, activeRoom: null, roomError: null }) %>

  <div class="flex-1 flex flex-col min-w-0">
    <div class="md:hidden flex items-center gap-2 px-4 py-3 border-b border-gray-200 dark:border-slate-700 bg-white dark:bg-slate-800">
      <button id="sidebar-open" class="p-1 text-gray-500 dark:text-gray-400">
        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5M3.75 17.25h16.5" />
        </svg>
      </button>
      <span class="font-semibold">Profile</span>
    </div>

    <div class="flex-1 flex items-center justify-center px-6">
      <div class="bg-white dark:bg-slate-800 border border-gray-300 dark:border-slate-700 rounded-2xl shadow-lg w-full max-w-sm p-8 flex flex-col items-center text-center">
        <% if (profilePicture) { %>
          <img src="<%= profilePicture %>" alt="" class="w-24 h-24 rounded-full object-cover">
        <% } else { %>
          <span class="w-24 h-24 rounded-full bg-indigo-50 dark:bg-indigo-500/15 flex items-center justify-center text-indigo-500 dark:text-indigo-400 text-3xl font-semibold">
            <%= (profileDisplayName || profileUsername).slice(0, 1).toUpperCase() %>
          </span>
        <% } %>

        <h1 class="text-xl font-bold mt-4"><%= profileDisplayName || profileUsername %></h1>
        <p class="text-sm text-gray-400 dark:text-gray-500">@<%= profileUsername %></p>

        <p class="text-sm text-gray-600 dark:text-gray-300 mt-4">
          <%= profileBio && profileBio.length > 0 ? profileBio : (isOwnProfile ? 'You haven\'t added a bio yet.' : 'No bio yet.') %>
        </p>

        <% if (isOwnProfile) { %>
          <a href="/profile/edit"
            class="mt-6 bg-indigo-600 text-white py-2.5 px-6 rounded-lg font-medium hover:bg-indigo-700 transition-colors shadow-sm">
            Edit Profile
          </a>
        <% } else { %>
          <a href="/dm/<%= profileUsername %>"
            class="mt-6 bg-indigo-600 text-white py-2.5 px-6 rounded-lg font-medium hover:bg-indigo-700 transition-colors shadow-sm">
            Message
          </a>
        <% } %>
      </div>
    </div>
  </div>

</body>

</html>
