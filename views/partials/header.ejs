<header class="bg-white shadow p-4 flex justify-between items-center flex-wrap gap-2">
    <div class="flex items-center gap-2">
        <a href="/chat" class="text-sm text-indigo-600 hover:underline">&larr; Rooms</a>
        <h1 class="text-xl font-bold">#<%= room %> <span class="text-sm font-normal text-gray-500">(<%= username %>)</span></h1>
    </div>
    <div class="flex items-center gap-2">
        <button id="video-call-btn" class="bg-blue-500 text-white py-2 px-4 rounded-md hover:bg-blue-600">Video
            Call</button>
        <% if (isOwner) { %>
            <form method="POST" action="/chat/<%= room %>/delete"
                onsubmit="return confirm('Delete #<%= room %> and all its messages? This cannot be undone.');">
                <button type="submit" class="bg-red-500 text-white py-2 px-4 rounded-md hover:bg-red-600">Delete
                    Room</button>
            </form>
        <% } else if (requiresApproval) { %>
            <form method="POST" action="/chat/<%= room %>/leave"
                onsubmit="return confirm('Leave #<%= room %>? You\'ll need the owner\'s approval again to rejoin.');">
                <button type="submit" class="bg-gray-200 text-gray-700 py-2 px-4 rounded-md hover:bg-gray-300">Leave
                    Room</button>
            </form>
        <% } %>
        <form method="POST" action="/logout">
            <button type="submit" class="bg-gray-200 text-gray-700 py-2 px-4 rounded-md hover:bg-gray-300">Log
                Out</button>
        </form>
    </div>
</header>
