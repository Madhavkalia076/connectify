<!DOCTYPE html>
<html lang="en">

<head>
  <%- include('partials/head', { title: 'Set up your profile — Connectify' }) %>
</head>

<body class="min-h-screen bg-slate-100 dark:bg-slate-900 font-sans text-gray-900 dark:text-gray-100 flex flex-col">

  <header class="flex items-center justify-between px-6 py-4">
    <div class="flex items-center gap-2">
      <svg class="w-6 h-6 text-indigo-600 dark:text-indigo-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round"
          d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 0 1-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8Z" />
      </svg>
      <span class="font-semibold">Connectify</span>
    </div>
    <%- include('partials/theme-toggle') %>
  </header>

  <main class="flex-1 flex items-center justify-center px-4">
    <div class="bg-white dark:bg-slate-800 border border-gray-300 dark:border-slate-700 flex flex-col p-8 rounded-2xl shadow-lg w-full max-w-sm">
      <h1 class="text-2xl font-bold mb-1 text-center">Set up your profile</h1>
      <p class="text-sm text-gray-500 dark:text-gray-400 text-center mb-6">
        One quick step before you start chatting.
      </p>

      <% if (error) { %>
        <p class="text-red-600 dark:text-red-400 text-sm bg-red-50 dark:bg-red-500/10 border border-red-200 dark:border-red-500/20 rounded-lg px-3 py-2 mb-4">
          <%= error %>
        </p>
      <% } %>

      <form method="POST" action="/profile/setup" enctype="multipart/form-data" class="flex flex-col gap-4">
        <div class="flex flex-col items-center">
          <label for="picture-input" class="relative block w-20 h-20 rounded-full cursor-pointer group" title="Add a profile picture">
            <img id="picture-preview" src="" alt="" class="hidden w-20 h-20 rounded-full object-cover">
            <span id="picture-placeholder" class="w-20 h-20 rounded-full bg-indigo-50 dark:bg-indigo-500/15 flex items-center justify-center text-indigo-400 dark:text-indigo-400">
              <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.501 20.118a7.5 7.5 0 0 1 14.998 0A17.933 17.933 0 0 1 12 21.75c-2.676 0-5.216-.584-7.499-1.632Z" />
              </svg>
            </span>
            <span class="absolute inset-0 rounded-full bg-black/0 group-hover:bg-black/30 transition-colors"></span>
          </label>
          <input type="file" id="picture-input" name="image" accept="image/jpeg,image/png,image/gif,image/webp" class="hidden">
          <p class="text-xs text-gray-400 dark:text-gray-500 mt-2">Optional — you can add this later too</p>
        </div>

        <div>
          <label for="displayName" class="text-xs font-medium text-gray-500 dark:text-gray-400 mb-1 block">Display name</label>
          <input type="text" id="displayName" name="displayName" required maxlength="30" autofocus
            placeholder="What should people call you?"
            class="w-full border border-gray-300 dark:border-slate-600 bg-white dark:bg-slate-900 rounded-lg px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500">
        </div>

        <div>
          <label for="bio" class="text-xs font-medium text-gray-500 dark:text-gray-400 mb-1 block">Bio / status <span class="font-normal">(optional)</span></label>
          <textarea id="bio" name="bio" maxlength="150" rows="2" placeholder="A short line about yourself"
            class="w-full border border-gray-300 dark:border-slate-600 bg-white dark:bg-slate-900 rounded-lg px-3 py-2.5 text-sm resize-none focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500"></textarea>
        </div>

        <button type="submit"
          class="mt-1 bg-indigo-600 text-white py-2.5 px-4 rounded-lg font-medium hover:bg-indigo-700 transition-colors shadow-sm">
          Continue to Connectify
        </button>
      </form>
    </div>
  </main>

  <script>
    // Client-side preview only — the actual file still goes up with the form on submit. Nothing
    // fancy: swap the placeholder icon for the picked image so picking a photo feels confirmed
    // immediately, rather than the user wondering if the file input silently did anything at all.
    document.getElementById('picture-input').addEventListener('change', function (event) {
      const file = event.target.files[0];
      if (!file) return;
      const preview = document.getElementById('picture-preview');
      const placeholder = document.getElementById('picture-placeholder');
      preview.src = URL.createObjectURL(file);
      preview.classList.remove('hidden');
      placeholder.classList.add('hidden');
    });
  </script>

</body>

</html>
