<!DOCTYPE html>
<html lang="en">

<head>
  <%- include('partials/head', { title: 'Edit Profile — Connectify' }) %>
</head>

<body class="h-dvh overflow-hidden bg-slate-100 dark:bg-slate-900 font-sans text-gray-900 dark:text-gray-100 flex">

  <%- include('partials/sidebar', { rooms, conversations, unreadCounts, dmPartnerProfiles, myDisplayName, myProfilePicture, username, activeRoom: null, roomError: null }) %>

  <div class="flex-1 flex flex-col min-w-0">
    <div class="md:hidden flex items-center gap-2 px-4 py-3 border-b border-gray-200 dark:border-slate-700 bg-white dark:bg-slate-800">
      <button id="sidebar-open" class="p-1 text-gray-500 dark:text-gray-400">
        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5M3.75 17.25h16.5" />
        </svg>
      </button>
      <span class="font-semibold">Edit Profile</span>
    </div>

    <div class="flex-1 flex items-center justify-center px-6">
      <div class="bg-white dark:bg-slate-800 border border-gray-300 dark:border-slate-700 rounded-2xl shadow-lg w-full max-w-sm p-8">
        <div class="flex items-center justify-between mb-6">
          <h1 class="text-xl font-bold">Edit Profile</h1>
          <a href="/profile/<%= username %>" class="text-gray-400 hover:text-gray-600 dark:hover:text-gray-200">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
            </svg>
          </a>
        </div>

        <% if (error) { %>
          <p class="text-red-600 dark:text-red-400 text-sm bg-red-50 dark:bg-red-500/10 border border-red-200 dark:border-red-500/20 rounded-lg px-3 py-2 mb-4">
            <%= error %>
          </p>
        <% } %>

        <form method="POST" action="/profile/edit" enctype="multipart/form-data" class="flex flex-col gap-4">
          <div class="flex flex-col items-center">
            <label for="picture-input" class="relative block w-20 h-20 rounded-full cursor-pointer group" title="Change profile picture">
              <% if (profilePicture) { %>
                <img id="picture-preview" src="<%= profilePicture %>" alt="" class="w-20 h-20 rounded-full object-cover">
              <% } else { %>
                <img id="picture-preview" src="" alt="" class="hidden w-20 h-20 rounded-full object-cover">
              <% } %>
              <span id="picture-placeholder" class="<%= profilePicture ? 'hidden' : '' %> w-20 h-20 rounded-full bg-indigo-50 dark:bg-indigo-500/15 flex items-center justify-center text-indigo-400 dark:text-indigo-400">
                <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.501 20.118a7.5 7.5 0 0 1 14.998 0A17.933 17.933 0 0 1 12 21.75c-2.676 0-5.216-.584-7.499-1.632Z" />
                </svg>
              </span>
              <span class="absolute inset-0 rounded-full bg-black/0 group-hover:bg-black/30 transition-colors"></span>
            </label>
            <input type="file" id="picture-input" name="image" accept="image/jpeg,image/png,image/gif,image/webp" class="hidden">
          </div>

          <div>
            <label for="displayName" class="text-xs font-medium text-gray-500 dark:text-gray-400 mb-1 block">Display name</label>
            <input type="text" id="displayName" name="displayName" required maxlength="30" value="<%= displayName %>"
              class="w-full border border-gray-300 dark:border-slate-600 bg-white dark:bg-slate-900 rounded-lg px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500">
          </div>

          <div>
            <label for="bio" class="text-xs font-medium text-gray-500 dark:text-gray-400 mb-1 block">Bio / status</label>
            <textarea id="bio" name="bio" maxlength="150" rows="2"
              class="w-full border border-gray-300 dark:border-slate-600 bg-white dark:bg-slate-900 rounded-lg px-3 py-2.5 text-sm resize-none focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500"><%= bio || '' %></textarea>
          </div>

          <button type="submit"
            class="mt-1 bg-indigo-600 text-white py-2.5 px-4 rounded-lg font-medium hover:bg-indigo-700 transition-colors shadow-sm">
            Save Changes
          </button>
        </form>
      </div>
    </div>
  </div>

  <script>
    document.getElementById('picture-input').addEventListener('change', function (event) {
      const file = event.target.files[0];
      if (!file) return;
      const preview = document.getElementById('picture-preview');
      const placeholder = document.getElementById('picture-placeholder');
      preview.src = URL.createObjectURL(file);
      preview.classList.remove('hidden');
      placeholder.classList.add('hidden');
    });
  </script>

</body>

</html>
