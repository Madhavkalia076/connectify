<!DOCTYPE html>
<html lang="en">

<head>
  <%- include('partials/head', { title: 'Connectify — Real-time chat' }) %>
</head>

<body class="min-h-screen bg-slate-100 dark:bg-slate-900 font-sans text-gray-900 dark:text-gray-100 flex flex-col">

  <header class="flex items-center justify-between px-6 py-4 max-w-5xl w-full mx-auto">
    <div class="flex items-center gap-2">
      <svg class="w-7 h-7 text-indigo-600 dark:text-indigo-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round"
          d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 0 1-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8Z" />
      </svg>
      <span class="text-lg font-semibold">Connectify</span>
    </div>
    <%- include('partials/theme-toggle') %>
  </header>

  <main class="flex-1 flex flex-col items-center justify-center px-6 text-center">
    <h1 class="text-4xl sm:text-5xl font-bold tracking-tight max-w-2xl">
      Real-time chat,<br class="hidden sm:block"> the way it should be.
    </h1>
    <p class="mt-4 text-gray-500 dark:text-gray-400 max-w-md">
      Rooms, live messaging, video calls, and file sharing — no clutter, no distractions.
    </p>

    <div class="mt-8 flex flex-col sm:flex-row gap-3 w-full max-w-xs sm:max-w-none sm:w-auto">
      <% if (username) { %>
        <p class="text-sm text-gray-500 dark:text-gray-400 sm:hidden mb-1">Logged in as <%= username %></p>
        <a href="/chat"
          class="text-center bg-indigo-600 text-white py-2.5 px-6 rounded-lg font-medium hover:bg-indigo-700 transition-colors shadow-sm">
          Go to Rooms
        </a>
        <form method="POST" action="/logout">
          <button type="submit"
            class="w-full text-center bg-white text-gray-700 border border-gray-300 py-2.5 px-6 rounded-lg font-medium hover:bg-gray-50 dark:bg-slate-800 dark:text-gray-200 dark:border-slate-600 dark:hover:bg-slate-700 transition-colors">
            Log Out
          </button>
        </form>
      <% } else { %>
        <a href="/login"
          class="text-center bg-indigo-600 text-white py-2.5 px-6 rounded-lg font-medium hover:bg-indigo-700 transition-colors shadow-sm">
          Log In
        </a>
        <a href="/signup"
          class="text-center bg-white text-gray-700 border border-gray-300 py-2.5 px-6 rounded-lg font-medium hover:bg-gray-50 dark:bg-slate-800 dark:text-gray-200 dark:border-slate-600 dark:hover:bg-slate-700 transition-colors">
          Sign Up
        </a>
      <% } %>
    </div>

    <div class="mt-16 grid grid-cols-1 sm:grid-cols-3 gap-4 max-w-3xl w-full">
      <div class="bg-white dark:bg-slate-800 border border-gray-300 dark:border-slate-700 shadow-md rounded-xl p-5 text-left">
        <div class="w-9 h-9 rounded-lg bg-indigo-50 dark:bg-indigo-500/10 flex items-center justify-center mb-3">
          <svg class="w-5 h-5 text-indigo-600 dark:text-indigo-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a4 4 0 0 0-3-3.87M9 20H4v-2a4 4 0 0 1 3-3.87m6-1a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm6 3a4 4 0 1 0 0-8 4 4 0 0 0 0 8Z" />
          </svg>
        </div>
        <h3 class="font-semibold text-sm">Rooms for every topic</h3>
        <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">Open channels or approval-only rooms — you decide who's in.</p>
      </div>
      <div class="bg-white dark:bg-slate-800 border border-gray-300 dark:border-slate-700 shadow-md rounded-xl p-5 text-left">
        <div class="w-9 h-9 rounded-lg bg-indigo-50 dark:bg-indigo-500/10 flex items-center justify-center mb-3">
          <svg class="w-5 h-5 text-indigo-600 dark:text-indigo-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 10l4.553-2.276A1 1 0 0 1 21 8.618v6.764a1 1 0 0 1-1.447.894L15 14M5 18h8a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2Z" />
          </svg>
        </div>
        <h3 class="font-semibold text-sm">Face-to-face, instantly</h3>
        <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">Jump on a video call with anyone in your room, no extra app.</p>
      </div>
      <div class="bg-white dark:bg-slate-800 border border-gray-300 dark:border-slate-700 shadow-md rounded-xl p-5 text-left">
        <div class="w-9 h-9 rounded-lg bg-indigo-50 dark:bg-indigo-500/10 flex items-center justify-center mb-3">
          <svg class="w-5 h-5 text-indigo-600 dark:text-indigo-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5.586a1 1 0 0 1 .707.293l5.414 5.414a1 1 0 0 1 .293.707V19a2 2 0 0 1-2 2Z" />
          </svg>
        </div>
        <h3 class="font-semibold text-sm">Share what matters</h3>
        <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">Drop in images right alongside your messages.</p>
      </div>
    </div>
  </main>

  <footer class="text-center text-xs text-gray-400 dark:text-gray-600 py-6">
    Built with Node.js, Express, Socket.io &amp; MongoDB.
  </footer>

</body>

</html>
