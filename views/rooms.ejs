<!DOCTYPE html>
<html lang="en">

<head>
  <%- include('partials/head', { title: 'Rooms — Connectify' }) %>
</head>

<body class="h-dvh overflow-hidden bg-slate-100 dark:bg-slate-900 font-sans text-gray-900 dark:text-gray-100 flex">

  <%- include('partials/sidebar', { rooms, conversations, unreadCounts, dmPartnerProfiles, myDisplayName, myProfilePicture, username, activeRoom: null, roomError }) %>

  <div class="flex-1 flex flex-col min-w-0">
    <div class="md:hidden flex items-center gap-2 px-4 py-3 border-b border-gray-200 dark:border-slate-700 bg-white dark:bg-slate-800">
      <button id="sidebar-open" class="p-1 text-gray-500 dark:text-gray-400">
        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5M3.75 17.25h16.5" />
        </svg>
      </button>
      <span class="font-semibold">Connectify</span>
    </div>

    <div class="flex-1 flex flex-col items-center justify-center text-center px-6">
      <div class="w-16 h-16 rounded-full bg-indigo-50 dark:bg-indigo-500/10 flex items-center justify-center mb-4">
        <svg class="w-8 h-8 text-indigo-500 dark:text-indigo-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 0 1-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8Z" />
        </svg>
      </div>
      <h1 class="text-lg font-semibold">Pick a room to start chatting</h1>
      <p class="text-sm text-gray-500 dark:text-gray-400 mt-1 max-w-xs">
        Choose one from the sidebar, or create a new one to get going.
      </p>
    </div>
  </div>

</body>

</html>
