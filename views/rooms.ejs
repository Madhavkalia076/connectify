<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Rooms — Connectify</title>
  <link href="/css/style.css" rel="stylesheet">
</head>

<body class="flex flex-col items-center min-h-screen bg-gray-200 p-4">
  <div class="bg-white flex items-center flex-col p-8 rounded-lg shadow-md w-full max-w-sm mt-8">
    <h1 class="text-2xl font-bold mb-1 text-center">Rooms</h1>
    <p class="text-sm text-gray-500 mb-4">Logged in as <%= username %></p>

    <% if (error) { %>
      <p class="text-red-600 text-sm mb-4"><%= error %></p>
    <% } %>

    <div class="w-full flex flex-col gap-2 mb-6">
      <% if (rooms.length === 0) { %>
        <p class="text-zinc-400 text-sm text-center">No rooms yet — create the first one below.</p>
      <% } %>
      <% rooms.forEach(function(room) { %>
        <a href="/chat/<%= room.name %>"
          class="border border-gray-300 rounded-md px-3 py-2 hover:bg-gray-50 flex justify-between items-center">
          <span>#<%= room.name %></span>
          <span class="text-xs text-gray-400">created by <%= room.createdBy %></span>
        </a>
      <% }) %>
    </div>

    <form method="POST" action="/chat/rooms" class="w-full flex flex-col gap-3 border-t pt-4">
      <label class="text-sm text-gray-600">Create a new room</label>
      <input type="text" name="name" placeholder="room-name" required maxlength="30"
        class="border border-gray-300 rounded-md px-3 py-2 focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm">
      <button type="submit"
        class="bg-indigo-600 text-white py-2 px-4 rounded-md hover:bg-indigo-700">Create & Join</button>
    </form>

    <form method="POST" action="/logout" class="w-full mt-4">
      <button type="submit" class="w-full text-center bg-gray-200 text-gray-700 py-2 px-4 rounded-md hover:bg-gray-300">Log
        Out</button>
    </form>
  </div>
</body>

</html>
