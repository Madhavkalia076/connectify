<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('partials/head', { title: '#' + room + ' — Connectify' }) %>
    <style>
        /* Kept as scoped CSS rather than Tailwind utilities — the video call UI relies on
           JS-toggled state classes (.smallFrame, .mic-muted, .camera-off) layered on top of
           fixed positioning that's easier to reason about here than composed inline. */
        #videos {
            display: grid;
            grid-template-columns: 1fr;
            height: 100dvh;
            overflow: hidden;
        }

        .video-player {
            background-color: #0f172a;
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .smallFrame {
            position: fixed;
            bottom: 100px;
            right: 20px;
            height: 170px;
            width: 260px;
            border-radius: 12px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.4);
            z-index: 10;
        }

        #controls {
            position: fixed;
            bottom: 24px;
            left: 50%;
            transform: translateX(-50%);
            display: flex;
            gap: 1rem;
            z-index: 20;
        }

        .control-container {
            background-color: rgba(255, 255, 255, 0.15);
            backdrop-filter: blur(8px);
            padding: 16px;
            border-radius: 50%;
            display: flex;
            justify-content: center;
            align-items: center;
            cursor: pointer;
            transition: background-color 150ms;
        }

        .control-container:hover {
            background-color: rgba(255, 255, 255, 0.25);
        }

        .control-container svg {
            height: 22px;
            width: 22px;
        }

        #hangup {
            background-color: #ef4444;
        }

        #hangup:hover {
            background-color: #dc2626;
        }

        .mic-muted,
        .camera-off {
            background-color: #ef4444 !important;
        }

        @media screen and (max-width: 600px) {
            .smallFrame {
                height: 90px;
                width: 130px;
                bottom: 90px;
                right: 12px;
            }

            #controls {
                bottom: 16px;
                gap: 0.75rem;
            }

            .control-container {
                padding: 12px;
            }
        }
    </style>
</head>

<body class="h-dvh overflow-hidden bg-slate-100 dark:bg-slate-900 font-sans text-gray-900 dark:text-gray-100 flex">

    <%- include('partials/sidebar', { rooms, username, activeRoom, roomError: null }) %>

    <div class="flex-1 flex flex-col min-w-0">

        <!-- Video call overlay -->
        <div class="fixed videoblock hidden z-[222] w-full h-dvh">
            <div id="videos">
                <video class="video-player" id="localVideo" autoplay muted playsinline></video>
                <video class="video-player" id="remoteVideo" autoplay playsinline></video>
            </div>
            <div id="controls">
                <div class="control-container" id="cameraButton">
                    <svg width="21" height="14" viewBox="0 0 21 14" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path
                            d="M20.525 2.149C20.365 2.05 20.183 2 20 2C19.847 2 19.694 2.035 19.553 2.105L17 3.382V3C17 1.346 15.654 0 14 0H3C1.346 0 0 1.346 0 3V11C0 12.654 1.346 14 3 14H14C15.654 14 17 12.654 17 11V10.618L19.553 11.894C19.694 11.965 19.847 12 20 12C20.183 12 20.365 11.95 20.525 11.851C20.82 11.668 21 11.347 21 11V3C21 2.653 20.82 2.332 20.525 2.149ZM5 8.5C4.171 8.5 3.5 7.829 3.5 7C3.5 6.171 4.171 5.5 5 5.5C5.829 5.5 6.5 6.171 6.5 7C6.5 7.829 5.829 8.5 5 8.5Z"
                            fill="white" />
                    </svg>
                </div>

                <div class="control-container" id="hangup">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                        <path d="M0 0h24v24H0z" fill="none" />
                        <path fill="white"
                            d="M20 15.5c-.78 0-1.55-.3-2.12-.88l-1.43-1.42a4.007 4.007 0 0 0-5.54 0l-1.43 1.42A2.983 2.983 0 0 1 4 15.5c-.78 0-1.55-.3-2.12-.88A2.983 2.983 0 0 1 1 12.5a2.983 2.983 0 0 1 .88-2.12l7-7a4.007 4.007 0 0 1 5.54 0l7 7c.58.58.88 1.34.88 2.12s-.3 1.55-.88 2.12c-.58.58-1.34.88-2.12.88z" />
                    </svg>
                </div>

                <div class="control-container" id="micButton">
                    <svg width="20" height="20" viewBox="0 0 14 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path fill-rule="evenodd" clip-rule="evenodd"
                            d="M7 12.5C8.7 12.5 10 11.2 10 9.5V3.5C10 1.8 8.7 0.5 7 0.5C5.3 0.5 4 1.8 4 3.5V9.5C4 11.2 5.3 12.5 7 12.5ZM12.3 9.5C12.3 12.5 9.8 14.6 7 14.6C4.2 14.6 1.7 12.5 1.7 9.5H0C0 12.9 2.7 15.7 6 16.2V19.5H8V16.2C11.3 15.7 14 12.9 14 9.5H12.3Z"
                            fill="white" />
                    </svg>
                </div>
            </div>
        </div>

        <!-- Incoming call modal -->
        <div id="incoming-call"
            class="fixed hidden z-[222] w-full h-dvh bg-black/60 flex items-center justify-center p-4">
            <div class="bg-white dark:bg-slate-800 p-8 rounded-2xl shadow-xl text-center">
                <p class="mb-4 font-medium" id="incoming-call-text">Incoming Call...</p>
                <div class="flex gap-3 justify-center">
                    <button id="accept-call" class="bg-green-500 text-white py-2 px-5 rounded-lg font-medium hover:bg-green-600 transition-colors">Accept</button>
                    <button id="reject-call" class="bg-red-500 text-white py-2 px-5 rounded-lg font-medium hover:bg-red-600 transition-colors">Reject</button>
                </div>
            </div>
        </div>

        <!-- Toolbar -->
        <header class="flex items-center justify-between gap-2 px-4 py-3 border-b border-gray-200 dark:border-slate-700 bg-white dark:bg-slate-800">
            <div class="flex items-center gap-2 min-w-0">
                <button id="sidebar-open" class="md:hidden p-1 text-gray-500 dark:text-gray-400 shrink-0">
                    <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5M3.75 17.25h16.5" />
                    </svg>
                </button>
                <div class="w-9 h-9 rounded-full bg-indigo-50 dark:bg-indigo-500/15 text-indigo-600 dark:text-indigo-400 flex items-center justify-center shrink-0 font-semibold">
                    #
                </div>
                <h1 class="font-semibold truncate"><%= room %></h1>
            </div>
            <div class="flex items-center gap-2 shrink-0">
                <button id="video-call-btn" title="Start a video call"
                    class="p-2 rounded-lg bg-indigo-50 dark:bg-indigo-500/15 text-indigo-600 dark:text-indigo-400 hover:bg-indigo-100 dark:hover:bg-indigo-500/25 transition-colors">
                    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M15 10l4.553-2.276A1 1 0 0 1 21 8.618v6.764a1 1 0 0 1-1.447.894L15 14M5 18h8a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2Z" />
                    </svg>
                </button>
                <button id="room-info-btn" title="Room info"
                    class="p-2 rounded-lg text-gray-500 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-slate-700 transition-colors">
                    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M11.25 11.25l.041-.02a.75.75 0 0 1 1.063.852l-.708 2.836a.75.75 0 0 0 1.063.853l.041-.021M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9-3.75h.008v.008H12V8.25Z" />
                    </svg>
                </button>
                <% if (isOwner && requiresApproval) { %>
                    <button id="pending-requests-btn" title="Pending join requests"
                        class="relative p-2 rounded-lg text-gray-500 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-slate-700 transition-colors">
                        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M18 18.72a9.094 9.094 0 0 0 3.741-.479 3 3 0 0 0-4.682-2.72m.94 3.198.001.031c0 .225-.012.447-.037.666A11.944 11.944 0 0 1 12 21c-2.17 0-4.207-.576-5.963-1.584A6.062 6.062 0 0 1 6 18.719m12 0a5.971 5.971 0 0 0-.941-3.197m0 0A5.995 5.995 0 0 0 12 12.75a5.995 5.995 0 0 0-5.058 2.772m0 0a3 3 0 0 0-4.681 2.72 8.986 8.986 0 0 0 3.74.477m.94-3.197a5.971 5.971 0 0 0-.94 3.197M15 6.75a3 3 0 1 1-6 0 3 3 0 0 1 6 0Zm6 3a2.25 2.25 0 1 1-4.5 0 2.25 2.25 0 0 1 4.5 0Zm-13.5 0a2.25 2.25 0 1 1-4.5 0 2.25 2.25 0 0 1 4.5 0Z" />
                        </svg>
                        <% if (pendingRequests.length > 0) { %>
                            <span class="absolute -top-0.5 -right-0.5 bg-red-500 text-white text-[10px] leading-none rounded-full w-4 h-4 flex items-center justify-center">
                                <%= pendingRequests.length %>
                            </span>
                        <% } %>
                    </button>
                <% } %>
                <% if (isOwner) { %>
                    <form method="POST" action="/chat/<%= room %>/delete"
                        onsubmit="return confirm('Delete #<%= room %> and all its messages? This cannot be undone.');">
                        <button type="submit" title="Delete room"
                            class="p-2 rounded-lg bg-red-50 dark:bg-red-500/15 text-red-600 dark:text-red-400 hover:bg-red-100 dark:hover:bg-red-500/25 transition-colors">
                            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0" />
                            </svg>
                        </button>
                    </form>
                <% } else if (requiresApproval) { %>
                    <form method="POST" action="/chat/<%= room %>/leave"
                        onsubmit="return confirm('Leave #<%= room %>? You\'ll need the owner\'s approval again to rejoin.');">
                        <button type="submit" title="Leave room"
                            class="p-2 rounded-lg bg-gray-100 dark:bg-slate-700 text-gray-500 dark:text-gray-400 hover:bg-gray-200 dark:hover:bg-slate-600 transition-colors">
                            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 9V5.25A2.25 2.25 0 0 0 13.5 3h-6a2.25 2.25 0 0 0-2.25 2.25v13.5A2.25 2.25 0 0 0 7.5 21h6a2.25 2.25 0 0 0 2.25-2.25V15M12 9l3 3m0 0-3 3m3-3H3" />
                            </svg>
                        </button>
                    </form>
                <% } %>
            </div>
        </header>

        <div id="presence-bar" class="bg-white dark:bg-slate-800 border-b border-gray-200 dark:border-slate-700 px-4 py-1 text-xs text-gray-500 dark:text-gray-400"></div>

        <main class="flex-1 p-4 overflow-y-auto relative" id="message-container">
            <% if (messages.length === 0) { %>
                <div
                    class="text-gray-400 dark:text-gray-600 absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-2/3 text-center nobody">
                    No messages yet — say hi!</div>
            <% } %>
            <% messages.forEach(function(msg) { %>
                <div class="flex my-2 <%= msg.username === username ? 'justify-end' : 'justify-start' %>" data-id="<%= msg._id %>">
                    <div class="max-w-xs">
                        <% if (msg.username !== username) { %>
                            <p class="text-xs text-gray-500 dark:text-gray-400 mb-1"><%= msg.username %></p>
                        <% } %>
                        <div class="message-body">
                            <% if (msg.deletedForEveryone) { %>
                                <div class="bg-gray-100 dark:bg-slate-700 text-gray-400 dark:text-gray-500 italic p-3 rounded-2xl text-sm">This message was deleted</div>
                            <% } else { %>
                                <% if (msg.type === 'image') { %>
                                    <img src="<%= msg.fileUrl %>" class="rounded-2xl max-w-full max-h-64" alt="shared image">
                                <% } else { %>
                                    <div class="<%= msg.username === username ? 'bg-indigo-600 text-white' : 'bg-white dark:bg-slate-700 text-gray-800 dark:text-gray-100 border border-gray-200 dark:border-slate-600' %> p-3 rounded-2xl">
                                        <p class="text-sm"><%= msg.text %></p>
                                    </div>
                                <% } %>
                                <div class="flex gap-2 mt-1 <%= msg.username === username ? 'justify-end' : 'justify-start' %>">
                                    <button class="delete-for-me text-[10px] text-gray-400 dark:text-gray-500 hover:underline" data-id="<%= msg._id %>">Delete for me</button>
                                    <% if (msg.username === username) { %>
                                        <button class="delete-for-everyone text-[10px] text-gray-400 dark:text-gray-500 hover:underline" data-id="<%= msg._id %>">Delete for everyone</button>
                                    <% } %>
                                </div>
                            <% } %>
                        </div>
                    </div>
                </div>
            <% }) %>
        </main>

        <p id="typing-indicator" class="px-4 text-xs text-gray-400 dark:text-gray-500 italic h-4"></p>

        <form id="chatform" class="bg-white dark:bg-slate-800 border-t border-gray-200 dark:border-slate-700 p-3 flex items-center gap-2">
            <label for="imageinput" title="Attach an image (JPEG/PNG/GIF/WEBP, max 5MB)"
                class="cursor-pointer p-2.5 rounded-lg text-gray-500 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-slate-700 transition-colors shrink-0">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="m18.375 12.739-7.693 7.693a4.5 4.5 0 0 1-6.364-6.364l10.94-10.94A3 3 0 1 1 19.5 7.372L8.552 18.32m.009-.01-.01.01m5.699-9.941-7.81 7.81a1.5 1.5 0 0 0 2.112 2.13" />
                </svg>
            </label>
            <input type="file" id="imageinput" accept="image/jpeg,image/png,image/gif,image/webp" class="hidden">
            <input type="text" id="messagebox"
                class="flex-1 border border-gray-300 dark:border-slate-600 bg-white dark:bg-slate-900 rounded-full px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500"
                placeholder="Type a message" autocomplete="off">
            <button type="submit" title="Send"
                class="p-2.5 rounded-full bg-indigo-600 text-white hover:bg-indigo-700 transition-colors shrink-0">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 12 3.269 3.126A59.768 59.768 0 0 1 21.485 12 59.77 59.77 0 0 1 3.27 20.876L5.999 12Zm0 0h7.5" />
                </svg>
            </button>
        </form>

        <video id="local-video" class="hidden" autoplay></video>
        <video id="remote-video" class="hidden" autoplay></video>

        <%- include('partials/room-info-modal', { room, isOwner, imageUrl, description, participants, requiresApproval, roomOwner }) %>
        <% if (isOwner && requiresApproval) { %>
            <%- include('partials/pending-requests-modal', { room, pendingRequests }) %>
        <% } %>
    </div>

    <script>
        // window.__socket is created once by partials/sidebar.ejs (which runs earlier in this
        // same page) and shared here — a page only ever needs one Socket.io connection. Because
        // that connection is also "watching" every other room the user belongs to (for unread
        // badges), every handler below has to check data.room before acting: without that, a
        // background room's typing indicator, presence update, or even video-call signal would
        // wrongly show up on whichever room's chat page happens to be open.
        const socket = window.__socket;
        const chatform = document.querySelector("#chatform");
        const messagebox = document.querySelector("#messagebox");
        const messagecontainer = document.querySelector("#message-container");
        const presenceBar = document.querySelector("#presence-bar");
        const typingIndicator = document.querySelector("#typing-indicator");

        // The room name and our own username are baked in server-side (from the URL and the
        // session) — unlike the old random-pairing flow, there's no "waiting to be matched"
        // step, we just join the room we're already viewing.
        const room = "<%= room %>";
        const myUsername = "<%= username %>";

        // The only join that marks presence (the "Online: ..." bar, the Room Info participant
        // list) — the sidebar's "watchRoom" joins for every other room deliberately skip that.
        socket.emit("joinroom", { roomId: room });

        socket.on("message", function (data) {
            if (data.room !== room) return; // a background room's message — the sidebar handles badging it
            if (data.type === "image") {
                renderImageMessage(data.id, data.username, data.fileUrl);
            } else {
                renderMessage(data.id, data.username, data.text);
            }
        })

        // --- Message deletion ---
        // Event delegation: the delete buttons live inside messages that get created both by
        // the server (page load) and dynamically by these render functions (live messages), so
        // one listener on the container catches clicks from either source instead of needing
        // to re-attach a listener every time a new message is rendered.
        messagecontainer.addEventListener("click", async function (event) {
            const forMeBtn = event.target.closest(".delete-for-me");
            const forEveryoneBtn = event.target.closest(".delete-for-everyone");

            if (forMeBtn) {
                const id = forMeBtn.dataset.id;
                const response = await fetch(`/messages/${id}/delete-for-me`, { method: "POST" });
                if (response.ok) {
                    // Only *my* view needs updating — nobody else is told, since this can never
                    // affect what anyone else sees.
                    document.querySelector(`[data-id="${id}"]`)?.remove();
                }
            }

            if (forEveryoneBtn) {
                if (!confirm("Delete this message for everyone? This cannot be undone.")) return;
                const id = forEveryoneBtn.dataset.id;
                const response = await fetch(`/messages/${id}/delete-for-everyone`, { method: "POST" });
                if (!response.ok) {
                    const body = await response.json().catch(function () { return {}; });
                    alert(body.error || "Couldn't delete this message.");
                }
                // No local update here — the server broadcasts "messageDeleted" back to the
                // whole room (sender included), and that's what actually swaps in the
                // placeholder. Same "wait for the server to confirm" pattern as sending a
                // message in the first place.
            }
        })

        socket.on("messageDeleted", function ({ id }) {
            const row = document.querySelector(`[data-id="${id}"]`);
            if (!row) return;
            // Only swaps out .message-body — leaves the sender's username label (a sibling
            // element, not a child of this wrapper) untouched.
            const body = row.querySelector(".message-body");
            body.innerHTML = '<div class="bg-gray-100 dark:bg-slate-700 text-gray-400 dark:text-gray-500 italic p-3 rounded-2xl text-sm">This message was deleted</div>';
        })

        chatform.addEventListener("submit", function (event) {
            event.preventDefault();
            const text = messagebox.value.trim();
            if (!text) return;
            socket.emit("message", { room: room, text: text });
            messagebox.value = "";
            // No local optimistic render here — the server broadcasts the message back to
            // everyone in the room, sender included, once it's saved to the database. That
            // keeps "what's on screen" and "what's actually persisted" from ever disagreeing.
        })

        // --- Image upload ---
        // Goes over a normal HTTP POST, not the socket connection — file uploads need
        // multipart/form-data, which isn't something Socket.io sends. Once the server has
        // saved it, it broadcasts a "message" event the same way text messages do, which is
        // what actually makes the image appear for everyone (including the uploader).
        const imageInput = document.querySelector("#imageinput");
        imageInput.addEventListener("change", async function () {
            const file = imageInput.files[0];
            if (!file) return;

            const formData = new FormData();
            formData.append("image", file);

            const response = await fetch(`/chat/${room}/upload`, {
                method: "POST",
                body: formData,
            });

            if (!response.ok) {
                const body = await response.json().catch(function () { return {}; });
                alert(body.error || "Upload failed.");
            }

            imageInput.value = ""; // reset so selecting the same file again still fires "change"
        })

        // --- Presence ---
        socket.on("presence", function ({ roomId, usernames }) {
            if (roomId !== room) return; // presence for a room we're only watching, not viewing
            const others = usernames.filter(function (name) { return name !== myUsername; });
            if (others.length === 0) {
                presenceBar.textContent = "Only you are here";
            } else {
                presenceBar.textContent = "Online: " + usernames.join(", ");
            }
        })

        // --- Typing indicator ---
        // Debounced so a fast typist doesn't fire a socket event on every single keystroke —
        // this only actually sends once per 500ms of continued typing, not once per keypress.
        let typingDebounceTimer = null;
        messagebox.addEventListener("input", function () {
            if (typingDebounceTimer) return; // already have one queued, skip this keystroke
            socket.emit("typing", { room: room });
            typingDebounceTimer = setTimeout(function () {
                typingDebounceTimer = null;
            }, 500);
        })

        let hideTypingTimer = null;
        socket.on("typing", function ({ username: typingUsername, room: typingRoom }) {
            if (typingRoom !== room) return; // someone typing in a room we're only watching
            typingIndicator.textContent = typingUsername + " is typing...";
            // Every new "typing" event pushes the auto-hide back out — the indicator only
            // disappears after ~2s with no further typing events from anyone.
            clearTimeout(hideTypingTimer);
            hideTypingTimer = setTimeout(function () {
                typingIndicator.textContent = "";
            }, 2000);
        })

        // Shared by both render functions below — the delete-controls row is identical either
        // way, only the bubble/image content above it differs.
        function buildDeleteControls(id, isMine) {
            const controls = document.createElement('div');
            controls.classList.add('flex', 'gap-2', 'mt-1', isMine ? 'justify-end' : 'justify-start');

            const deleteForMe = document.createElement('button');
            deleteForMe.classList.add('delete-for-me', 'text-[10px]', 'text-gray-400', 'dark:text-gray-500', 'hover:underline');
            deleteForMe.dataset.id = id;
            deleteForMe.textContent = 'Delete for me';
            controls.appendChild(deleteForMe);

            if (isMine) {
                const deleteForEveryone = document.createElement('button');
                deleteForEveryone.classList.add('delete-for-everyone', 'text-[10px]', 'text-gray-400', 'dark:text-gray-500', 'hover:underline');
                deleteForEveryone.dataset.id = id;
                deleteForEveryone.textContent = 'Delete for everyone';
                controls.appendChild(deleteForEveryone);
            }

            return controls;
        }

        function renderMessage(id, fromUsername, text) {
            document.querySelector(".nobody")?.classList.add("hidden");

            const isMine = fromUsername === myUsername;

            const row = document.createElement('div');
            row.classList.add('flex', 'my-2', isMine ? 'justify-end' : 'justify-start');
            row.dataset.id = id;

            const wrap = document.createElement('div');
            wrap.classList.add('max-w-xs');

            if (!isMine) {
                const label = document.createElement('p');
                label.classList.add('text-xs', 'text-gray-500', 'dark:text-gray-400', 'mb-1');
                label.textContent = fromUsername;
                wrap.appendChild(label);
            }

            const body = document.createElement('div');
            body.classList.add('message-body');

            const bubble = document.createElement('div');
            bubble.classList.add('p-3', 'rounded-2xl', ...(isMine ? ['bg-indigo-600', 'text-white'] : ['bg-white', 'dark:bg-slate-700', 'text-gray-800', 'dark:text-gray-100', 'border', 'border-gray-200', 'dark:border-slate-600']));

            const p = document.createElement('p');
            p.classList.add('text-sm');
            p.textContent = text;
            bubble.appendChild(p);
            body.appendChild(bubble);
            body.appendChild(buildDeleteControls(id, isMine));
            wrap.appendChild(body);
            row.appendChild(wrap);

            messagecontainer.appendChild(row);
            messagecontainer.scrollTop = messagecontainer.scrollHeight;
        }

        function renderImageMessage(id, fromUsername, fileUrl) {
            document.querySelector(".nobody")?.classList.add("hidden");

            const isMine = fromUsername === myUsername;

            const row = document.createElement('div');
            row.classList.add('flex', 'my-2', isMine ? 'justify-end' : 'justify-start');
            row.dataset.id = id;

            const wrap = document.createElement('div');
            wrap.classList.add('max-w-xs');

            if (!isMine) {
                const label = document.createElement('p');
                label.classList.add('text-xs', 'text-gray-500', 'dark:text-gray-400', 'mb-1');
                label.textContent = fromUsername;
                wrap.appendChild(label);
            }

            const body = document.createElement('div');
            body.classList.add('message-body');

            const img = document.createElement('img');
            img.src = fileUrl;
            img.alt = 'shared image';
            img.classList.add('rounded-2xl', 'max-w-full', 'max-h-64');
            body.appendChild(img);
            body.appendChild(buildDeleteControls(id, isMine));
            wrap.appendChild(body);
            row.appendChild(wrap);

            messagecontainer.appendChild(row);
            messagecontainer.scrollTop = messagecontainer.scrollHeight;
        }

        // scroll to the bottom of the server-rendered history on first load
        messagecontainer.scrollTop = messagecontainer.scrollHeight;

        // WEBRTC START
        // Known limitation: this is still a 1-on-1 signaling flow (RTCPeerConnection only
        // ever talks to one peer). In a room with more than 2 people, "Video Call" broadcasts
        // to everyone in the room and whoever accepts first connects — true group video
        // calling would need per-target signaling (or an SFU server) and isn't built here.
        let localStream;
        let remoteStream;
        let peerConnection;
        let inCall = false;

        const rtcSettings = {
            iceServers: [{ urls: "stun:stun.l.google.com:19302" }],
        };

        const initialize = async () => {
            socket.on("signalingMessage", handleSignalingMessage);

            try {
                localStream = await navigator.mediaDevices.getUserMedia({
                    audio: true,
                    video: true
                })
                document.querySelector("#localVideo").srcObject = localStream;
                document.querySelector("#localVideo").style.display = "block";

                initiateOffer();

                inCall = true;
            }
            catch (err) {
                console.log("Rejected by browser" + err);
            }
        }

        const initiateOffer = async () => {
            await createPeerConnection();
            try {
                const offer = await peerConnection.createOffer();
                await peerConnection.setLocalDescription(offer);
                socket.emit("signalingMessage", {
                    room,
                    message: JSON.stringify({
                        type: "offer",
                        offer
                    })
                })
            }
            catch (err) {
                console.log("error in creating offer" + err);
            }
        }

        const createPeerConnection = () => {
            peerConnection = new RTCPeerConnection(rtcSettings);

            remoteStream = new MediaStream();

            document.querySelector("#remoteVideo").srcObject = remoteStream;
            document.querySelector("#remoteVideo").style.display = "block";
            document.querySelector("#localVideo").classList.add("smallFrame");

            localStream.getTracks().forEach(track => {
                peerConnection.addTrack(track, localStream);
            })

            peerConnection.ontrack = (event) => {
                event.streams[0].getTracks().forEach(track => {
                    remoteStream.addTrack(track);
                })
            }

            peerConnection.onicecandidate = (event) => {
                if (event.candidate) {
                    console.log("Sending Ice Candidates");

                    socket.emit("signalingMessage", {
                        room,
                        message: JSON.stringify({
                            type: "candidate",
                            candidate: event.candidate
                        })
                    })
                }
            }

            peerConnection.onconnectionstatechange = () => {
                console.log("connection state change hui ", peerConnection.connectionState);
            }
        }

        const handleSignalingMessage = async (payload) => {
            if (payload.room !== room) return; // signaling for a call happening in a different room
            const { type, offer, answer, candidate } = JSON.parse(payload.message);
            if (type === "offer") handleOffer(offer);
            if (type === "answer") handleAnswer(answer);
            if (type === "candidate" && peerConnection) {
                try { await peerConnection.addIceCandidate(candidate); }
                catch (error) {
                    console.log(error);
                }
            }
            if (type === "hangup") {
                hangup()
            }
        }

        const handleOffer = async (offer) => {
            await createPeerConnection();
            try {
                await peerConnection.setRemoteDescription(offer);
                const answer = await peerConnection.createAnswer();
                await peerConnection.setLocalDescription(answer);
                socket.emit("signalingMessage", { room, message: JSON.stringify({ type: "answer", answer }) });
                inCall = true;
            }
            catch (error) {
                console.log("failed to handle offer");
            }
        }

        const handleAnswer = async (answer) => {
            try {
                await peerConnection.setRemoteDescription(answer);
            }
            catch (error) {
                console.log("failed to handle answer");
            }
        }


        document.querySelector("#video-call-btn")
            .addEventListener("click", function () {
                socket.emit("startVideoCall", { room })
            })

        socket.on("incomingCall", function ({ from, room: callRoom }) {
            if (callRoom !== room) return; // a call happening in a room we're only watching
            document.querySelector("#incoming-call-text").textContent = `Incoming call from ${from}...`;
            document.querySelector("#incoming-call").classList.remove("hidden");
        })

        socket.on("callAccepted", function ({ room: callRoom }) {
            if (callRoom !== room) return;
            initialize();
            document.querySelector(".videoblock").classList.remove("hidden");
        })

        document.querySelector("#accept-call")
            .addEventListener("click", function () {
                document.querySelector("#incoming-call").classList.add("hidden");
                initialize();
                document.querySelector(".videoblock").classList.remove("hidden");
                socket.emit("acceptCall", { room })
            })
        document.querySelector("#reject-call").addEventListener("click", function () {
            document.querySelector("#incoming-call").classList.add("hidden");
            socket.emit("rejectCall", { room });
        })

        socket.on("callRejected", function ({ room: callRoom }) {
            if (callRoom !== room) return;
            alert("call rejected by the user");
        })

        document.querySelector("#hangup")
            .addEventListener("click", function () {
                hangup();
            })

        document.querySelector("#cameraButton")
            .addEventListener("click", function () {
                toggleCamera();
            })

        document.querySelector("#micButton")
            .addEventListener("click", function () {

                toggleMute();
            })

        function toggleMute() {
            if (localStream) {
                localStream.getAudioTracks().forEach(track => {
                    track.enabled = !track.enabled;
                    isMuted = !track.enabled;
                });
                const micButton = document.querySelector("#micButton");
                if (isMuted) {
                    micButton.classList.add("mic-muted");
                } else {
                    micButton.classList.remove("mic-muted");
                }

            }
        }

        function toggleCamera() {
            if (localStream) {
                localStream.getVideoTracks().forEach(track => {
                    track.enabled = !track.enabled;
                    isCameraOff = !track.enabled;
                });
                const cameraButton = document.querySelector("#cameraButton");
                if (isCameraOff) {
                    cameraButton.classList.add("camera-off");
                } else {
                    cameraButton.classList.remove("camera-off");
                }
            }
        }

        function hangup() {
            if (peerConnection) {
                peerConnection.close();
                peerConnection = null;
                localStream.getTracks().forEach(track => track.stop());

                document.querySelector(".videoblock").classList.add("hidden");
                socket.emit("signalingMessage", { room, message: JSON.stringify({ type: "hangup" }) });
                inCall = false;
            }
        }
    </script>
</body>

</html>
