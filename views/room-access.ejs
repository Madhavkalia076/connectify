<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>#<%= room %> — Connectify</title>
  <link href="/css/style.css" rel="stylesheet">
</head>

<body class="flex items-center justify-center h-screen bg-gray-200">
  <div class="bg-white flex items-center flex-col p-8 rounded-lg shadow-md w-full max-w-xs text-center">
    <h1 class="text-xl font-bold mb-2">#<%= room %></h1>

    <% if (isPending) { %>
      <p class="text-gray-500 mb-4">Your request to join has been sent. Waiting for the room owner
        to approve it.</p>
      <a href="/chat/<%= room %>" class="text-sm text-indigo-600 hover:underline">Check again</a>
    <% } else { %>
      <p class="text-gray-500 mb-4">This room requires the owner's approval to join.</p>
      <form method="POST" action="/chat/<%= room %>/request" class="w-full">
        <button type="submit"
          class="w-full bg-indigo-600 text-white py-2 px-4 rounded-md hover:bg-indigo-700">Request to
          Join</button>
      </form>
    <% } %>

    <a href="/chat" class="text-sm text-gray-500 mt-4 hover:underline">&larr; Back to rooms</a>
  </div>
</body>

</html>
