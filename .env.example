PORT=3000
MONGODB_URI=your_mongodb_atlas_connection_string
SESSION_SECRET=change_me
# Free TURN credentials from metered.ca — needed for video calls to connect reliably when the two
# people calling are on different networks (e.g. one on mobile data). Sign up free at metered.ca,
# create an app, and their dashboard gives you these two values directly.
TURN_USERNAME=your_metered_turn_username
TURN_CREDENTIAL=your_metered_turn_credential
